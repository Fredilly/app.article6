# === Qwen 2.5-VL scaffolding (choose one provider later) ===
# Local/VLLM (self-hosted) — e.g., http://localhost:8000
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-vl
QWEN_PROVIDER=echo    # options: echo | local | hf

# === GeoVista verification (server-side only) ===
# Enable the UI slot via NEXT_PUBLIC_GEOVISTA_ENABLED=true, but keep secrets server-only:
GEOVISTA_BASE_URL=
GEOVISTA_API_KEY=
GEOVISTA_TIMEOUT_MS=15000
