    "preverif:rc3:audited-pre-fix-baseline": "tsx scripts/preverif/generate-vm0007-rc3-audited-pre-fix-baseline.ts",
    "preverif:rc3:baseline-registry": "tsx scripts/preverif/generate-vm0007-rc3-baseline-registry.ts",
    "test:quickcheck:no-fixture-hardcoding": "jest tests/lib/quickCheckV2/no-fixture-hardcoding-guard.test.ts --runInBand",
    "check:golden": "bash scripts/check-golden-rich.sh",
    "build:audit-pack": "node scripts/build-audit-pack.mjs",
    "build:derived": "node scripts/build-derived-artifacts.mjs",
    "verify:audit-pack": "node scripts/verify-audit-pack.mjs",
    "verify:derived": "node scripts/verify-derived-artifacts.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "validate:artifacts": "node scripts/validate-artifacts.mjs",
    "drift:artifacts": "node scripts/drift-artifacts.mjs",
    "roadmap:init": "node scripts/roadmap/init-roadmap.mjs",
    "roadmap:check": "npm run roadmap:gen && git diff --exit-code -- docs/roadmaps/SUMMARY.md",
    "roadmap:status": "node scripts/roadmap/status.mjs",
    "roadmap:validate": "node scripts/roadmap/validate-ssot.mjs",
    "roadmap:validate-evidence": "node scripts/roadmap/validate-pr-evidence.mjs",
    "ticket:new": "node scripts/tickets/new-ticket.mjs",
    "ticket:list": "node scripts/tickets/list-tickets.mjs",
    "status:check": "node scripts/status-check.mjs",
    "vercel-build": "npm run build",
    "prebuild": "npm run fetch:methodologies-pack && npm run generate:manifest && npm run derive:all && npm run assert:derived && npm run check:golden",
    "generate:manifest": "node scripts/generate-manifest-from-pack.mjs",
    "determinism:audit-pack": "node scripts/determinism-audit-pack.mjs",
    "pr:gate": "node scripts/pr-gate.mjs",
    "pr:check:local": "npm run guard:methodology-boundary && npm run lint && npm run typecheck && npm run check:docs-layout && npm run roadmap:validate-evidence && npm run preverif:guard:truth-review && git diff --check",
    "ci:coverage": "node scripts/compute-coverage.mjs",
    "ci:ratchet": "node scripts/gate-coverage-ratchet.mjs",
    "ci:links": "node scripts/gate-link-resolver.mjs",
    "manifest:derived": "node scripts/build-derived-manifest.mjs",
    "assert:derived": "node scripts/assert-derived-present.mjs",
    "derive:all": "npm run build:derived && npm run manifest:derived && npm run verify:derived",
    "audit-pack:diff": "node scripts/audit-pack/diff-manifests.mjs",
    "prepare": "husky install",
    "roadmap:gen": "node scripts/roadmap/gen-roadmap.mjs",
    "roadmap:update": "node scripts/roadmap/roadmap-update.mjs",
    "test:derived:determinism": "node scripts/test-derived-determinism.mjs",
    "test:audit-pack:trail-smoke": "node scripts/test-audit-pack-trail-smoke.mjs",
    "analyze:fallow": "fallow dead-code --format compact --summary || true; fallow dupes --format compact --summary || true; fallow health --format compact --summary --top 10 || true",
    "analyze:fallow:json": "mkdir -p artifacts/fallow && fallow dead-code --format json --quiet --summary > artifacts/fallow/dead-code.json 2>/dev/null || true; fallow dupes --format json --quiet --summary > artifacts/fallow/dupes.json 2>/dev/null || true; fallow health --format json --quiet --summary --top 20 > artifacts/fallow/health.json 2>/dev/null || true; echo 'Fallow JSON reports written to artifacts/fallow/{dead-code,dupes,health}.json'"
  },
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
