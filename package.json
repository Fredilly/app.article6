    "check:manifest": "node -e \"const x=require('./public/manifest/index.json');if(!Array.isArray(x)||x.length<10){console.error('Manifest too small');process.exit(1)}\"",
    "check:docs-layout": "node scripts/check-docs-layout.mjs",
    "check:quick-check-pdf-trace": "node scripts/check-quick-check-pdf-trace.mjs",
    "dev:manifest:count": "node -e \"console.log(require('./public/manifest/index.json').length)\"",
    "fetch:methodologies-pack": "bash scripts/fetch-methodologies-pack.sh",
    "guard:methodology-boundary": "node scripts/guard-methodology-boundary.mjs",
    "quickcheck:guard:no-fixture-hardcoding": "node scripts/quickcheck/check-no-fixture-hardcoding.mjs",
    "preverif:guard:truth-review": "node scripts/preverif/check-truth-review-guard.mjs",
    "preverif:rc2:baseline": "tsx scripts/preverif/generate-vm0007-rc2-baseline.ts",
    "preverif:rc3:diagnostic": "tsx scripts/preverif/generate-vm0007-rc3-diagnostic.ts",
    "preverif:rc3:same-run-handoff": "tsx scripts/preverif/generate-vm0007-rc3-same-run-handoff.ts",
    "preverif:rc3:current-comparison": "tsx scripts/preverif/generate-vm0007-rc3-current-comparison.ts",
